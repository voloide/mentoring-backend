<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260223-01-add-partners-to-health_facilities" author="voloide">
        <addColumn tableName="health_facilities">
            <column name="CLINICAL_PARTNER_ID" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="OTHER_PARTNERS" type="JSON">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="health_facilities"
                baseColumnNames="CLINICAL_PARTNER_ID"
                constraintName="fk_hf_clinical_partner"
                referencedTableName="partners"
                referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>